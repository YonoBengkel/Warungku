# Salin jadi .env lalu sesuaikan bila perlu.
# Port 5433 mengikuti docker-compose.yml supaya tidak bentrok dengan
# PostgreSQL yang mungkin sudah berjalan di port 5432.
WARUNGKU_DB=postgresql+psycopg2://warungku:warungku@localhost:5433/warungku_dev

# Alamat layanan model. API utama memanggilnya hanya dari penjadwal,
# tidak pernah saat halaman dibuka.
WARUNGKU_ML=http://localhost:8001
