# Lingkungan Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv-ml/
.pytest_cache/
.ipynb_checkpoints/

# Rahasia (juga sudah tertutup .gitignore akar)
.env

# Keluaran eksperimen & dataset besar
keluaran/*
*.parquet

# Tapi ringkasan hasil eksperimen ikut dilacak: berkasnya kecil, dan angka
# di laporan harus bisa ditelusuri ke berkas yang menghasilkannya — bukan ke
# ingatan orang yang kebetulan menjalankannya.
!keluaran/hasil_*.json

# Dataset nyata dari pihak luar. Lisensinya tidak selalu terbuka (French Bakery:
# "© Original Authors"), jadi berkas datanya tidak ikut dilacak. README di tiap
# folder tetap dilacak, supaya anggota tim tahu dari mana mengunduhnya.
data_nyata/**/*.csv
